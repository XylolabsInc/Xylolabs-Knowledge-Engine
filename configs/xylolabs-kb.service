[Unit]
Description=Xylolabs Knowledge Base Worker
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/xylolabs-kb
ExecStart=/opt/xylolabs-kb/bin/xylolabs-kb
EnvironmentFile=/opt/xylolabs-kb/.env
Restart=always
RestartSec=5
# On stop, SIGTERM only the bot. It waits for a running plugin submission
# and then closes the DaouOffice plugin itself; the default control-group
# mode would SIGTERM the Node plugin at once and cut the submission off.
# Anything left after the bot exits is killed. The bot's stop takes at most
# 5m30s (a 5m10s drain, then up to 20s to close the plugin; see stopBudget in
# cmd/xylolabs-kb/main.go), so this leaves a minute of margin.
KillMode=mixed
TimeoutStopSec=390
StandardOutput=journal
StandardError=journal
AmbientCapabilities=CAP_NET_BIND_SERVICE


[Install]
WantedBy=multi-user.target
